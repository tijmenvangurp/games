{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@app/*": ["./apps/games/src/app/*"],
      "@pages/*": ["./libs/pages/*/index.ts"],
      "@widgets/*": ["./libs/widgets/*/index.ts"],
      "@features/*": ["./libs/features/*/index.ts"],
      "@entities/*": ["./libs/entities/*/index.ts"],
      "@shared/lib": ["./libs/shared/lib/index.ts"],
      "@shared/lib/*": ["./libs/shared/lib/*"],
      "@shared/ui": ["./libs/shared/ui/index.ts"],
      "@shared/ui/*": ["./libs/shared/ui/*"],
      "@/*": ["./apps/games/src/*"]
    }
  }
}
