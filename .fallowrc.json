{
  "$schema": "./node_modules/fallow/schema.json",
  "ignoreDependencies": ["nx-mcp"],
  "ignoreExports": [
    {
      "file": "libs/entities/murdoku/model/engine/**",
      "exports": ["*"]
    },
    {
      "file": "libs/features/murdoku-game/lib/vendored/**",
      "exports": ["*"]
    }
  ],
  "overrides": [
    {
      "files": ["libs/entities/murdoku/model/engine/**"],
      "rules": {
        "unused-types": "off",
        "unused-class-members": "off"
      }
    },
    {
      "files": ["libs/features/murdoku-game/lib/vendored/**"],
      "rules": {
        "unused-types": "off",
        "unused-class-members": "off"
      }
    }
  ],
  "entry": [
    "apps/games/src/app/main.tsx",
    "steiger.config.ts",
    "commitlint.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "apps/games/vite.config.ts",
    "tools/aliases.ts",
    "scripts/check-ts-only.ts",
    "scripts/generate-app-icons.ts",
    "scripts/generate-chess-puzzles.ts",
    "scripts/generate-geography.ts",
    "scripts/generate-french-audio.ts",
    "scripts/generate-sounds.ts",
    "scripts/generate-audio.ts",
    "scripts/run-playwright.ts",
    "scripts/hooks/commit-msg.ts",
    "scripts/hooks/pre-commit.ts",
    "scripts/hooks/pre-push.ts"
  ],
  "rules": {
    "css-selector-complexity": "error"
  },
  "duplicates": {
    "ignore": [
      "scripts/generate-sounds.ts",
      "libs/entities/murdoku/model/engine/**",
      "libs/features/murdoku-game/lib/vendored/**"
    ]
  },
  "health": {
    "coverage": "coverage/coverage-final.json",
    "thresholdOverrides": [
      {
        "files": ["scripts/wav.ts"],
        "maxCyclomatic": 25,
        "maxCognitive": 32,
        "maxCrap": 650,
        "maxUnitSize": 110,
        "reason": "Dev-only WAV-parser voor het klankprototype; geen runtime-code en nog geen unit-tests."
      },
      {
        "files": ["scripts/generate-geography.ts"],
        "maxCyclomatic": 12,
        "maxCognitive": 12,
        "maxCrap": 150,
        "reason": "Eenmalig generatiescript: het parseert externe data (Wikidata, Wikimedia Commons, TopoJSON) en heeft geen unit-coverage. De uitvoer wordt bewaakt door tests/node/flags-generator.test.ts en pnpm run geography:check."
      },
      {
        "files": ["libs/features/flag-game/ui/**", "libs/pages/flags/**"],
        "maxCyclomatic": 14,
        "maxCognitive": 22,
        "maxCrap": 60,
        "reason": "React-schermen met veel voorwaardelijke SVG-attributen; de CRAP-schatting telt JSX-takken mee. Gedekt door tests/web/puzzle.test.tsx, tests/web/flags.test.tsx en de mobiele e2e-ronde."
      },
      {
        "files": [
          "scripts/generate-audio.ts",
          "scripts/lib/audio-catalog.ts",
          "scripts/lib/tts.ts",
          "scripts/generate-french-audio.ts"
        ],
        "maxCyclomatic": 14,
        "maxCognitive": 26,
        "maxCrap": 120,
        "reason": "Dev-only audiogeneratoren en de catalogusscanner; de uitvoer wordt bewaakt door pnpm run audio:check en tests/node/speech-audio.test.ts."
      },
      {
        "files": ["libs/entities/murdoku/model/engine/**"],
        "maxCyclomatic": 130,
        "maxCognitive": 260,
        "maxCrap": 4000,
        "maxUnitSize": 500,
        "reason": "1:1 vendored MIT-engine (LifeValuable/murdoku); de complexiteit en duplicatie zijn eigendom van de upstream-bron en worden niet door ons onderhouden. Onze eigen wrapper en public API vallen buiten deze override en blijven volledig getest."
      },
      {
        "files": ["libs/features/murdoku-game/lib/vendored/**"],
        "maxCyclomatic": 130,
        "maxCognitive": 260,
        "maxCrap": 4000,
        "maxUnitSize": 500,
        "reason": "1:1 vendored MIT-renderlaag (LifeValuable/murdoku): canvas-art voor meubels, vloeren en portretten. De complexiteit is eigendom van de upstream-bron; onze eigen teksten, palette, preview-fixture en bordcomponent vallen buiten deze override en zijn getest."
      }
    ]
  },
  "boundaries": {
    "zones": [
      { "name": "app", "patterns": ["apps/games/src/app/**"] },
      { "name": "pages", "patterns": ["libs/pages/**"] },
      { "name": "widgets", "patterns": ["libs/widgets/**"] },
      { "name": "features", "patterns": ["libs/features/**"] },
      { "name": "entities", "patterns": ["libs/entities/**"] },
      { "name": "shared", "patterns": ["libs/shared/**"] }
    ],
    "rules": [
      { "from": "app", "allow": ["pages", "widgets", "features", "entities", "shared"] },
      { "from": "pages", "allow": ["widgets", "features", "entities", "shared"] },
      { "from": "widgets", "allow": ["features", "entities", "shared"] },
      { "from": "features", "allow": ["entities", "shared"] },
      { "from": "entities", "allow": ["shared"] },
      { "from": "shared", "allow": ["shared"] }
    ]
  }
}
