{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/games/src/app/main.tsx",
    "steiger.config.ts",
    "commitlint.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "apps/games/vite.config.ts",
    "tools/aliases.ts",
    "scripts/check-ts-only.ts",
    "scripts/generate-app-icons.ts",
    "scripts/generate-chess-puzzles.ts",
    "scripts/generate-geography.ts",
    "scripts/generate-french-audio.ts",
    "scripts/generate-sounds.ts",
    "scripts/run-playwright.ts",
    "scripts/hooks/commit-msg.ts",
    "scripts/hooks/pre-commit.ts",
    "scripts/hooks/pre-push.ts"
  ],
  "rules": {
    "css-selector-complexity": "error"
  },
  "duplicates": {
    "ignore": ["scripts/generate-sounds.ts"]
  },
  "health": {
    "coverage": "coverage/coverage-final.json",
    "thresholdOverrides": [
      {
        "files": ["scripts/wav.ts"],
        "maxCyclomatic": 25,
        "maxCognitive": 32,
        "maxCrap": 650,
        "maxUnitSize": 110,
        "reason": "Dev-only WAV-parser voor het klankprototype; geen runtime-code en nog geen unit-tests."
      },
      {
        "files": ["scripts/generate-geography.ts"],
        "maxCyclomatic": 12,
        "maxCognitive": 12,
        "maxCrap": 150,
        "reason": "Eenmalig generatiescript: het parseert externe data (Wikidata, Wikimedia Commons, TopoJSON) en heeft geen unit-coverage. De uitvoer wordt bewaakt door tests/node/flags-generator.test.ts en pnpm run geography:check."
      },
      {
        "files": ["libs/features/flag-game/ui/**", "libs/pages/flags/**"],
        "maxCyclomatic": 14,
        "maxCognitive": 22,
        "maxCrap": 60,
        "reason": "React-schermen met veel voorwaardelijke SVG-attributen; de CRAP-schatting telt JSX-takken mee. Gedekt door tests/web/puzzle.test.tsx, tests/web/flags.test.tsx en de mobiele e2e-ronde."
      }
    ]
  },
  "boundaries": {
    "zones": [
      { "name": "app", "patterns": ["apps/games/src/app/**"] },
      { "name": "pages", "patterns": ["libs/pages/**"] },
      { "name": "widgets", "patterns": ["libs/widgets/**"] },
      { "name": "features", "patterns": ["libs/features/**"] },
      { "name": "entities", "patterns": ["libs/entities/**"] },
      { "name": "shared", "patterns": ["libs/shared/**"] }
    ],
    "rules": [
      { "from": "app", "allow": ["pages", "widgets", "features", "entities", "shared"] },
      { "from": "pages", "allow": ["widgets", "features", "entities", "shared"] },
      { "from": "widgets", "allow": ["features", "entities", "shared"] },
      { "from": "features", "allow": ["entities", "shared"] },
      { "from": "entities", "allow": ["shared"] },
      { "from": "shared", "allow": ["shared"] }
    ]
  }
}
