{
  "name": "games",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx run games:serve",
    "build": "nx run games:build",
    "preview": "nx run games:preview",
    "lint": "nx run-many -t lint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "ui:add": "shadcn add",
    "test": "vitest",
    "test:run": "nx run tests:test",
    "test:coverage": "nx run tests:coverage",
    "typecheck:node": "tsc --project tsconfig.node.json",
    "typecheck:web": "tsc --project tsconfig.web.json",
    "typecheck": "nx run games:typecheck",
    "e2e": "pnpm exec tsx scripts/run-playwright.ts",
    "fsd": "steiger ./libs --fail-on-warnings && steiger ./apps/games/src --fail-on-warnings",
    "boundaries": "fallow dead-code --boundary-violations",
    "fallow": "fallow audit",
    "affected": "nx affected -t lint,typecheck,test,build",
    "graph": "nx graph",
    "check": "pnpm run ts-only && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build",
    "quality": "pnpm run ts-only && pnpm run format:check && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run boundaries && pnpm run fallow",
    "quality:full": "pnpm run quality && pnpm run lint && pnpm run fsd",
    "quality:ci": "pnpm run quality:full && pnpm run e2e",
    "ts-only": "pnpm exec tsx scripts/check-ts-only.ts",
    "prepare": "husky",
    "icons": "pnpm exec tsx scripts/generate-app-icons.ts",
    "geography": "pnpm exec tsx scripts/generate-geography.ts",
    "geography:check": "pnpm exec tsx scripts/generate-geography.ts --check",
    "elements": "pnpm exec tsx scripts/fetch-element-sprites.ts",
    "audio:french": "pnpm exec tsx scripts/generate-french-audio.ts",
    "audio:check:french": "pnpm exec tsx scripts/generate-french-audio.ts --check",
    "audio:nl": "pnpm exec tsx scripts/generate-audio.ts",
    "audio:check": "pnpm exec tsx scripts/generate-audio.ts --check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-router": "^1.170.44",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "sudoku-gen": "1.0.3",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "3.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fallow": "^3.33.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "nx": "23.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "steiger": "^0.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
