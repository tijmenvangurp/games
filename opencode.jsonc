{
  "$schema": "https://opencode.ai/config.json",
  // Project-local agent permissions. Global rules load first; these narrow
  // exceptions load last, so they win only for the actions listed here.
  "permissions": [
    // Allow edits inside this repository. The TypeScript-only policy from
    // AGENTS.md is re-stated because these rules load after the global ones.
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.js", "effect": "deny" },
    { "action": "edit", "resource": "*.mjs", "effect": "deny" },
    { "action": "edit", "resource": "*.cjs", "effect": "deny" },
    { "action": "edit", "resource": "*.jsx", "effect": "deny" },
    { "action": "edit", "resource": "*.py", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // Routine package, build, test and inspection commands.
    { "action": "shell", "resource": "corepack *", "effect": "allow" },
    // Ad-hoc Playwright scripts need the bundled browser libraries and fonts.
    // The env prefix makes the command different from plain `corepack *`, so
    // allow the two prefix orders explicitly instead of prompting every time.
    { "action": "shell", "resource": "LD_LIBRARY_PATH=* corepack *", "effect": "allow" },
    { "action": "shell", "resource": "FONTCONFIG_PATH=* corepack *", "effect": "allow" },
    // Last-resort workaround for a stuck Nx daemon; prefer
    // `corepack pnpm exec nx ...` and see docs/tooling.md.
    { "action": "shell", "resource": "NX_DAEMON=false corepack *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "nx *", "effect": "allow" },
    { "action": "shell", "resource": "tsc *", "effect": "allow" },
    { "action": "shell", "resource": "tsx *", "effect": "allow" },
    { "action": "shell", "resource": "vite *", "effect": "allow" },
    { "action": "shell", "resource": "vitest *", "effect": "allow" },
    { "action": "shell", "resource": "oxlint *", "effect": "allow" },
    { "action": "shell", "resource": "oxfmt *", "effect": "allow" },
    { "action": "shell", "resource": "steiger *", "effect": "allow" },
    { "action": "shell", "resource": "fallow *", "effect": "allow" },
    { "action": "shell", "resource": "wrangler *", "effect": "allow" },
    { "action": "shell", "resource": "playwright *", "effect": "allow" },
    { "action": "shell", "resource": "opencode *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "git branch --list *", "effect": "allow" },
    { "action": "shell", "resource": "git switch -c *", "effect": "allow" },
    { "action": "shell", "resource": "git mv *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    // Read-only inspection. Create or replace files with the write tool, not
    // `cat > file`, so the shell scanner does not need to approve a write.
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "true", "effect": "allow" },
    { "action": "shell", "resource": "exit *", "effect": "allow" },

    // Delivery commands: branch, push, PR, checks and merge.
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull *", "effect": "allow" },
    { "action": "shell", "resource": "git remote *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },

    // Destructive operations stay blocked.
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },

    // Narrow cleanup allowances for temporary files created during a task.
    // General `rm` remains an explicit decision instead of a blanket allow.
    { "action": "shell", "resource": "rm -f .tmp-*", "effect": "allow" },
    { "action": "shell", "resource": "rm -f /tmp/opencode/*", "effect": "allow" },

    // Agent tooling used while working in this repository.
    { "action": "execute", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },

    // Scratch space only; every other external directory still asks. The read
    // and edit rules make the allow explicit for the tools, not just for the
    // external-directory boundary check.
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "read", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/opencode/*", "effect": "allow" },
  ],
}
